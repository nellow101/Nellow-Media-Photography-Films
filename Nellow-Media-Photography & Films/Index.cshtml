<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nellow Media | Photography & Films</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
                scroll-behavior: smooth;
            }

            body {
                background-color: #07070d;
                color: #ffffff;
                overflow-x: hidden;
            }

            /* Subtle Purple / Blue Gradient Background with Orangered Accents */
            .bg-gradient-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: radial-gradient(circle at 15% 20%, rgba(90, 45, 140, 0.22) 0%, transparent 45%), radial-gradient(circle at 85% 80%, rgba(30, 80, 160, 0.18) 0%, transparent 45%), radial-gradient(circle at 50% 50%, rgba(255, 87, 34, 0.05) 0%, transparent 60%), #07070d;
                z-index: -2;
                pointer-events: none;
            }

            .bg-video-container {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                overflow: hidden;
                z-index: -3;
            }

            #bg-video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: brightness(75%) blur(6px);
                opacity: 0.6;
            }

            header {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 30px;
                background: rgba(15, 13, 25, 0.75);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(176, 132, 204, 0.12);
                z-index: 1000;
            }

            .logo-container {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                cursor: pointer;
            }

            .logo-small {
                height: 40px;
                width: 40px;
                object-fit: cover;
                border-radius: 50%;
                border: 2px solid #b084cc;
            }

            .logo-text {
                color: #fff;
                font-weight: 600;
                font-size: 1rem;
                letter-spacing: 0.5px;
            }

            nav ul {
                display: flex;
                list-style: none;
                gap: 22px;
                align-items: center;
            }

                nav ul li a {
                    color: #e2e2e2;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 500;
                    transition: color 0.3s ease;
                }

                    nav ul li a:hover {
                        color: #ff5722;
                    }

            .nav-whatsapp {
                background: linear-gradient(135deg, #25D366, #1ebe57);
                color: #fff !important;
                padding: 7px 16px;
                border-radius: 20px;
                font-weight: 600 !important;
                box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
                transition: transform 0.2s ease !important;
            }

                .nav-whatsapp:hover {
                    transform: scale(1.05);
                }

            .hero {
                height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
                padding: 0 20px;
                position: relative;
            }

            .logo-center {
                max-width: 160px;
                width: 35%;
                border-radius: 16px;
                margin-bottom: 20px;
                box-shadow: 0 10px 30px rgba(176, 132, 204, 0.2);
                border: 2px solid rgba(176, 132, 204, 0.4);
                animation: floatLogo 4s ease-in-out infinite;
            }

            @@keyframes floatLogo {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-10px);
                }
            }

            .hero h1 {
                font-size: clamp(2.2rem, 5vw, 3.8rem);
                font-weight: 700;
                letter-spacing: 1px;
                margin-bottom: 5px;
                background: linear-gradient(135deg, #ffffff 40%, #b084cc 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .hero p {
                font-size: clamp(0.9rem, 2vw, 1.15rem);
                color: #bfaed6;
                margin-bottom: 35px;
                font-weight: 400;
            }

            .scroll-down {
                position: absolute;
                bottom: 30px;
                display: flex;
                flex-direction: column;
                align-items: center;
                color: #fff;
                text-decoration: none;
                font-size: 13px;
                opacity: 0.8;
                transition: opacity 0.3s;
            }

                .scroll-down:hover {
                    opacity: 1;
                    color: #ff5722;
                }

                .scroll-down i {
                    margin-top: 5px;
                    animation: bounce 2s infinite;
                }

            @@keyframes bounce {
                0%, 20%, 50%, 80%, 100% {
                    transform: translateY(0);
                }

                40% {
                    transform: translateY(-8px);
                }

                60% {
                    transform: translateY(-4px);
                }
            }

            .section-container {
                padding: 90px 20px;
                max-width: 1200px;
                margin: 0 auto;
            }

            .section-title {
                text-align: center;
                font-size: 2.3rem;
                margin-bottom: 12px;
                font-weight: 700;
                background: linear-gradient(135deg, #fff, #b084cc);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .section-subtitle {
                text-align: center;
                color: #aaa;
                font-size: 0.95rem;
                margin-bottom: 45px;
            }

            .folders-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 25px;
            }

            .folder-card {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(176, 132, 204, 0.15);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-radius: 16px;
                overflow: hidden;
                cursor: pointer;
                transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease, border-color 0.4s;
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            }

                .folder-card:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 12px 40px 0 rgba(255, 87, 34, 0.15);
                    border-color: rgba(255, 87, 34, 0.4);
                }

            .folder-thumb {
                height: 200px;
                width: 100%;
                object-fit: cover;
                background-color: #050505;
                transition: transform 0.5s ease;
            }

            .folder-card:hover .folder-thumb {
                transform: scale(1.05);
            }

            .folder-info {
                padding: 22px;
                text-align: center;
            }

                .folder-info h3 {
                    font-size: 1.2rem;
                    font-weight: 600;
                    margin-bottom: 5px;
                }

                .folder-info p {
                    font-size: 0.85rem;
                    color: #bfaed6;
                }

            .pricing-section {
                background: rgba(15, 12, 24, 0.6);
                border-top: 1px solid rgba(176, 132, 204, 0.1);
                border-bottom: 1px solid rgba(176, 132, 204, 0.1);
                padding: 90px 20px;
            }

            .pricing-tabs {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 40px;
            }

            .tab-btn {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(176, 132, 204, 0.2);
                color: #fff;
                padding: 10px 22px;
                border-radius: 30px;
                cursor: pointer;
                font-size: 0.9rem;
                font-weight: 500;
                transition: all 0.3s ease;
            }

                .tab-btn:hover, .tab-btn.active {
                    background: linear-gradient(135deg, #b084cc, #8a58ab);
                    border-color: #b084cc;
                    box-shadow: 0 4px 15px rgba(176, 132, 204, 0.3);
                }

            .pricing-category-container {
                display: none;
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeIn 0.4s ease forwards;
            }

                .pricing-category-container.active {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
                    gap: 25px;
                }

            .price-card {
                background: rgba(25, 20, 38, 0.65);
                border: 1px solid rgba(176, 132, 204, 0.15);
                border-radius: 20px;
                padding: 32px;
                display: flex;
                flex-direction: column;
                position: relative;
                transition: transform 0.3s ease, border-color 0.3s;
                box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            }

                .price-card.featured {
                    border-color: #ff5722;
                    background: rgba(30, 22, 45, 0.85);
                    box-shadow: 0 12px 35px rgba(255, 87, 34, 0.18);
                }

                .price-card:hover {
                    transform: translateY(-6px);
                    border-color: #b084cc;
                }

            .badge-popular {
                position: absolute;
                top: -14px;
                right: 25px;
                background: linear-gradient(135deg, #ff5722, #f44336);
                color: #fff;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                padding: 5px 14px;
                border-radius: 20px;
                letter-spacing: 0.5px;
                box-shadow: 0 4px 10px rgba(255, 87, 34, 0.4);
            }

            .tier-name {
                font-size: 1.1rem;
                font-weight: 600;
                color: #bfaed6;
                margin-bottom: 8px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .tier-price {
                font-size: 2.2rem;
                font-weight: 700;
                color: #fff;
                margin-bottom: 20px;
            }

                .tier-price span {
                    font-size: 0.9rem;
                    font-weight: 400;
                    color: #aaa;
                }

            .tier-features {
                list-style: none;
                margin-bottom: 30px;
                flex-grow: 1;
            }

                .tier-features li {
                    font-size: 0.9rem;
                    color: #ddd;
                    padding: 9px 0;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .tier-features li i {
                        color: #25D366;
                        font-size: 0.95rem;
                    }

            .book-package-btn {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                gap: 8px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(176, 132, 204, 0.3);
                color: #fff;
                padding: 12px;
                border-radius: 12px;
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.3s ease;
            }

            .price-card.featured .book-package-btn {
                background: linear-gradient(135deg, #ff5722, #e64a19);
                border-color: #ff5722;
                box-shadow: 0 4px 15px rgba(255, 87, 34, 0.3);
            }

            .book-package-btn:hover {
                background: #b084cc;
                border-color: #b084cc;
                color: #000;
            }

            .price-card.featured .book-package-btn:hover {
                background: #f4511e;
                color: #fff;
            }

            .services-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
                gap: 25px;
                margin-top: 20px;
            }

            .service-card {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.07);
                backdrop-filter: blur(10px);
                border-radius: 16px;
                padding: 32px 24px;
                text-align: left;
                position: relative;
                overflow: hidden;
                transition: all 0.3s ease;
            }

                .service-card::after {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 4px;
                    height: 100%;
                    background: linear-gradient(to bottom, #b084cc, #ff5722);
                    opacity: 0.7;
                }

                .service-card:hover {
                    background: rgba(255, 255, 255, 0.05);
                    border-color: rgba(176, 132, 204, 0.3);
                    transform: translateY(-5px);
                }

                .service-card i {
                    font-size: 2.2rem;
                    color: #b084cc;
                    margin-bottom: 18px;
                }

                .service-card h4 {
                    font-size: 1.2rem;
                    margin-bottom: 10px;
                    font-weight: 600;
                }

                .service-card p {
                    font-size: 0.88rem;
                    color: #ccc;
                    line-height: 1.6;
                }

            .gallery-view {
                display: none;
                padding: 100px 20px 60px 20px;
                max-width: 1200px;
                margin: 0 auto;
                animation: fadeIn 0.5s ease forwards;
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .back-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff;
                padding: 8px 18px;
                border-radius: 30px;
                cursor: pointer;
                font-size: 14px;
                margin-bottom: 30px;
                transition: background 0.3s;
                backdrop-filter: blur(5px);
            }

                .back-btn:hover {
                    background: rgba(255, 255, 255, 0.2);
                    color: #ff5722;
                }

            .image-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 20px;
            }

            .image-item {
                border-radius: 12px;
                overflow: hidden;
                background: rgba(255,255,255,0.03);
                border: 1px solid rgba(255,255,255,0.08);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 8px;
            }

                .image-item img, .image-item video {
                    width: 100%;
                    height: auto;
                    max-height: 450px;
                    object-fit: cover;
                    border-radius: 8px;
                    transition: transform 0.3s ease;
                    cursor: pointer;
                }

                    .image-item img:hover {
                        transform: scale(1.02);
                    }

            .lightbox-modal {
                display: none;
                position: fixed;
                z-index: 2000;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.9);
                backdrop-filter: blur(8px);
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

            .lightbox-content {
                max-width: 90%;
                max-height: 85vh;
                object-fit: contain;
                border-radius: 8px;
                box-shadow: 0 5px 30px rgba(0,0,0,0.8);
                animation: zoomIn 0.3s ease;
            }

            @@keyframes zoomIn {
                from {
                    transform: scale(0.9);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .lightbox-close {
                position: absolute;
                top: 25px;
                right: 30px;
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff;
                font-size: 20px;
                width: 45px;
                height: 45px;
                border-radius: 50%;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background 0.3s;
            }

                .lightbox-close:hover {
                    background: rgba(255, 255, 255, 0.3);
                }

            .contact-section {
                padding: 90px 20px;
                max-width: 600px;
                margin: 0 auto;
                text-align: center;
            }

            .running-cameraman {
                position: absolute;
                bottom: 15%;
                left: -150px;
                width: 130px;
                height: auto;
                z-index: 2;
                pointer-events: none;
                animation: runAcross 18s linear infinite;
            }

            @@keyframes runAcross {
                0% {
                    left: -150px;
                    transform: scaleX(1);
                }

                49% {
                    transform: scaleX(1);
                }

                50% {
                    left: calc(100% + 50px);
                    transform: scaleX(-1);
                }

                99% {
                    transform: scaleX(-1);
                }

                100% {
                    left: -150px;
                    transform: scaleX(1);
                }
            }

            .whatsapp-btn {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                background: linear-gradient(135deg, #25D366, #1ebe57);
                color: #fff;
                padding: 14px 32px;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 600;
                font-size: 16px;
                box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
                transition: transform 0.3s, background-color 0.3s;
                margin-top: 20px;
            }

                .whatsapp-btn:hover {
                    transform: scale(1.05);
                }

            footer {
                text-align: center;
                padding: 30px 20px;
                font-size: 0.85rem;
                color: #888;
                border-top: 1px solid rgba(255,255,255,0.05);
                background: rgba(5, 4, 10, 0.8);
            }

                footer span {
                    color: #b084cc;
                }
    </style>
</head>
<body>

    <div class="bg-video-container">
        <video autoplay muted loop id="bg-video" playsinline>
            <source src="./images/background.mp4" type="video/mp4">
        </video>
    </div>
    <div class="bg-gradient-overlay"></div>

    <header>
        <a onclick="showHome()" class="logo-container">
            <img src="./images/logo-small.png" alt="Logo" class="logo-small" onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&auto=format&fit=crop&q=80'" />
            <span class="logo-text">Nellow Media</span>
        </a>
        <nav>
            <ul>
                <li><a href="#work" onclick="showHome()">Work</a></li>
                <li><a href="#packages" onclick="showHome()">Packages</a></li>
                <li><a href="#services" onclick="showHome()">Services</a></li>
                <li><a href="#contact" onclick="showHome()">Contact</a></li>
                <li><a href="https://wa.me/27820729075?text=Hi%20Nellow%20Media,%20I%20would%20like%20to%20book%20a%20session!" target="_blank" class="nav-whatsapp"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a></li>
            </ul>
        </nav>
    </header>

    <div id="home-view">
        <section class="hero">
            <img src="./images/cameraman.gif" alt="Running Cameraman" class="running-cameraman" onerror="this.style.display='none'" />
            <img src="./images/logo-center.png" alt="Nellow Media Center Logo" class="logo-center" onerror="this.src='https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=300&auto=format&fit=crop&q=80'" />
            <h1>Nellow Media</h1>
            <p>PREMIUM PHOTOGRAPHY & FILMS COMPANY</p>
            <a href="#work" class="scroll-down">
                Explore Portfolio & Packages
                <i class="fa-solid fa-chevron-down"></i>
            </a>
        </section>

        <section id="work" class="section-container">
            <h2 class="section-title">Explore Categories</h2>
            <p class="section-subtitle">Click any folder to view our full collection of captured moments</p>
            <div class="folders-grid">
                <div class="folder-card" onclick="openCategory('Portraits')">
                    <img id="thumb-Portraits" src="" alt="Portraits" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Portraits</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Weddings')">
                    <img id="thumb-Weddings" src="" alt="Weddings" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Wedding / Umshado</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Zulu Events')">
                    <img id="thumb-Zulu Events" src="" alt="Zulu Events" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Zulu Events / Ceremonies</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Birthday Parties')">
                    <img id="thumb-Birthday Parties" src="" alt="Birthday Parties" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Birthday Parties</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Drone Shots')">
                    <img id="thumb-Drone Shots" src="" alt="Drone Shots" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Drone Photography</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Graduation')">
                    <img id="thumb-Graduation" src="" alt="Graduation" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Graduation</h3>
                        <p>View Collection</p>
                    </div>
                </div>

                <div class="folder-card" onclick="openCategory('Videos')">
                    <img id="thumb-Videos" src="" alt="Videos" class="folder-thumb" />
                    <div class="folder-info">
                        <h3>Videos</h3>
                        <p>View Collection</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="packages" class="pricing-section">
            <div class="section-container" style="padding: 0 20px;">
                <h2 class="section-title">Packages & Pricing</h2>
                <p class="section-subtitle">Choose the perfect tier tailored for your special occasion</p>

                <div class="pricing-tabs">
                    <button class="tab-btn active" onclick="switchPricingTab('zulu')"><i class="fa-solid fa-drum"></i> Zulu Events / Ceremonies</button>
                    <button class="tab-btn" onclick="switchPricingTab('wedding')"><i class="fa-solid fa-ring"></i> Wedding / Umshado</button>
                    <button class="tab-btn" onclick="switchPricingTab('birthday')"><i class="fa-solid fa-cake-candles"></i> Birthday Parties</button>
                    <button class="tab-btn" onclick="switchPricingTab('portrait')"><i class="fa-solid fa-camera"></i> Portraits</button>
                    <button class="tab-btn" onclick="switchPricingTab('drone')"><i class="fa-solid fa-helicopter"></i> Drone Photography</button>
                </div>

                <!-- 1. Zulu Events / Ceremonies -->
                <div id="pricing-zulu" class="pricing-category-container active">
                    <div class="price-card">
                        <div class="tier-name">Standard Tier</div>
                        <div class="tier-price">R 4,500 <span>/ event</span></div>
                        <ul class="tier-features">
                            <li><i class="fa-solid fa-check"></i> 6 Hours Professional Coverage</li>
                            <li><i class="fa-solid fa-check"></i> 1 Lead Photographer</li>
                            <li><i class="fa-solid fa-check"></i> 100+ High-Res Edited Digital Photos</li>
                            <li><i class="fa-solid fa-check"></i> Secure Online Web Gallery</li>
                            <li><i class="fa-solid fa-check"></i> 5-7 Business Days Delivery</li>
                        </ul>
                        <a href="https://wa.me/27820729075?text=Hi%20Nellow%20Media,%20I%20would%20like%20to%20book%20the%20Zulu%20Events%20Standard%20Package%20(R4,500)." target="_blank" class="book-package-btn">Book via WhatsApp</a>
