    <script>
            document.getElementById('current-year').textContent = new Date().getFullYear();

            /*
              GitHub Repository Folder Mapping Strategy:
              Place files in your repo under:
              - images/portraits/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/weddings/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/zulu-events/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/birthdays/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/drone/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/graduation/ (1.jpg, 2.jpg, 3.jpg, ...)
              - images/videos/ (1.mp4, 2.mp4, ...)
            */

            const folderMap = {
                "Portraits": "images/portraits/",
                "Weddings": "images/weddings/",
                "Zulu Events": "images/zulu-events/",
                "Birthday Parties": "images/birthdays/",
                "Drone Shots": "images/drone/",
                "Graduation": "images/graduation/",
                "Videos": "images/videos/"
            };

            // Fallback demo images for immediate preview when folders are empty
            const fallbackData = {
                "Portraits": [
                    "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=800&auto=format&fit=crop&q=80"
                ],
                "Weddings": [
                    "https://images.unsplash.com/photo-1519741497674-611481863552?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=800&auto=format&fit=crop&q=80"
                ],
                "Zulu Events": [
                    "https://images.unsplash.com/photo-1511578314322-379afb476865?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop&q=80"
                ],
                "Birthday Parties": [
                    "https://images.unsplash.com/photo-1513151233558-d860c5398176?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1464349153735-7db50ed83c84?w=800&auto=format&fit=crop&q=80"
                ],
                "Drone Shots": [
                    "https://images.unsplash.com/photo-1508614589041-895b88991e3e?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1527977966376-1c8408f9f108?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1579829366248-204fe84172f1?w=800&auto=format&fit=crop&q=80"
                ],
                "Graduation": [
                    "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1525921429624-479b6a26d84d?w=800&auto=format&fit=crop&q=80",
                    "https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=800&auto=format&fit=crop&q=80"
                ],
                "Videos": [
                    "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
                    "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
                ]
            };

            // Generates sequence filenames (1.jpg to 12.jpg) to automatically detect user images dropped in folders
            async function getCategoryMedia(categoryName) {
                const folder = folderMap[categoryName];
                if (!folder) return fallbackData[categoryName] || [];

                const detectedFiles = [];
                const maxCheck = 15; // checks 1.jpg up to 15.jpg

                const extension = categoryName === 'Videos' ? 'mp4' : 'jpg';

                for (let i = 1; i <= maxCheck; i++) {
                    const path = `${folder}${i}.${extension}`;
                    try {
                        const exists = await checkImageExists(path);
                        if (exists) {
                            detectedFiles.push(path);
                        }
                    } catch (e) {
                        // skip
                    }
                }

                // If user hasn't added files yet, fall back to stunning stock photos
                if (detectedFiles.length === 0) {
                    return fallbackData[categoryName] || [];
                }

                return detectedFiles;
            }

            function checkImageExists(url) {
                return new Promise((resolve) => {
                    if (url.endsWith('.mp4')) {
                        // For video check
                        const vid = document.createElement('video');
                        vid.src = url;
                        vid.onloadedmetadata = () => resolve(true);
                        vid.onerror = () => resolve(false);
                    } else {
                        const img = new Image();
                        img.src = url;
                        img.onload = () => resolve(true);
                        img.onerror = () => resolve(false);
                    }
                });
            }

            // Initialize thumbnails on page load
            document.addEventListener("DOMContentLoaded", async () => {
                for (const catName of Object.keys(folderMap)) {
                    const mediaList = await getCategoryMedia(catName);
                    const thumb = document.getElementById(`thumb-${catName}`);
                    if (thumb && mediaList && mediaList.length > 0) {
                        thumb.src = mediaList[0];
                        thumb.onerror = function() {
                            this.src = `https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=600&auto=format&fit=crop&q=80`;
                        };
                    }
                }
            });

            function switchPricingTab(tabKey) {
                const tabs = document.querySelectorAll('.tab-btn');
                tabs.forEach(btn => btn.classList.remove('active'));

                const containers = document.querySelectorAll('.pricing-category-container');
                containers.forEach(cont => cont.classList.remove('active'));

                event.currentTarget.classList.add('active');
                const targetContainer = document.getElementById(`pricing-${tabKey}`);
                if (targetContainer) {
                    targetContainer.classList.add('active');
                }
            }

            async function openCategory(categoryName) {
                document.getElementById('home-view').style.display = 'none';
                const catView = document.getElementById('category-view');
                catView.style.display = 'block';

                document.getElementById('category-title').textContent = categoryName;

                const gridContainer = document.getElementById('image-grid-container');
                gridContainer.innerHTML = `<p style="color:#aaa; text-align:center; grid-column: 1/-1; padding: 40px 0;"><i class="fa-solid fa-spinner fa-spin"></i> Loading ${categoryName} gallery...</p>`;

                const mediaList = await getCategoryMedia(categoryName);
                gridContainer.innerHTML = '';

                if (mediaList.length === 0) {
                    gridContainer.innerHTML = `<p style="color:#aaa; text-align:center; grid-column: 1/-1; padding: 40px 0;">No items found in <strong>images/${categoryName.toLowerCase()}</strong> yet. Add 1.jpg, 2.jpg... to your repository!</p>`;
                } else {
                    mediaList.forEach(mediaUrl => {
                        const item = document.createElement('div');
                        item.className = 'image-item';

                        if (categoryName === 'Videos') {
                            item.innerHTML = `
                                <video controls preload="metadata">
                                    <source src="${mediaUrl}" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>`;
                        } else {
                            item.innerHTML = `<img src="${mediaUrl}" alt="${categoryName} photo" onclick="openLightbox('${mediaUrl}')" onerror="this.src='https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=600&auto=format&fit=crop&q=80'">`;
                        }
                        gridContainer.appendChild(item);
                    });
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function showHome() {
                document.getElementById('category-view').style.display = 'none';
                document.getElementById('home-view').style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function openLightbox(imgUrl) {
                const lightbox = document.getElementById('lightbox');
                const lightboxImg = document.getElementById('lightbox-img');
                lightboxImg.src = imgUrl;
                lightbox.style.display = 'flex';
            }

            function closeLightbox() {
                document.getElementById('lightbox').style.display = 'none';
            }
    </script>
</body>
</html>